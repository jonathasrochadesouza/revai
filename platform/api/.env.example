# RevAI API — environment overrides
# Copy to .env to change anything. Every Settings field is overridable with the
# REVAI_ prefix.

# REVAI_HOST=127.0.0.1
# REVAI_PORT=8799
# REVAI_ENVIRONMENT=development

# Where projects, reviews and config live. Defaults to ~/.revai
# REVAI_DATA_DIR=~/.revai

# --- Provider credentials (phase 2) -----------------------------------------
# Preferred location is ~/.revai/credentials.yaml (chmod 600). These env vars
# exist for CI and containers, where a file is inconvenient.
# REVAI_OPENROUTER_API_KEY=sk-or-v1-...
